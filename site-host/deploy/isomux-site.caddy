# /etc/wg-caddy/isomux-site.caddy: isomux.com on the shared VPS. Imported from the host's
# Caddyfile beside the Wall Game, Hosted Isomux, bigOspeedrun and nilmamano.com blocks. The
# host's global options trust Cloudflare's ranges with client_ip_headers CF-Connecting-IP
# (/etc/wg-caddy/cloudflare-ips.caddy), so {client_ip} is the visitor. Behind Cloudflare,
# ACME's TLS-ALPN challenge cannot reach Caddy, so the names use HTTP-01.
#
# Plain HTTP: the host's catch-all http:// block answers unknown names with 421 (its global
# options disable the automatic redirects), and Cloudflare's Always Use HTTPS is off. Vercel
# answered with a 308 to HTTPS on the same name, path and query kept; Caddy does the same.
# ACME's HTTP-01 challenge is still answered on port 80. This block has no cloudflare_only
# gate: Caddy sorts redir before abort, so the gate would run after the 308 and never
# refuse. A direct port-80 request gets only the 308 to the gated HTTPS block.
http://isomux.com, http://www.isomux.com {
	redir https://{host}{uri} 308
}

# Both names go to the site, which redirects www to the apex itself (vercel.json).
isomux.com, www.isomux.com {
	# Refuse connections that do not come from Cloudflare. No handle blocks here, so a
	# top-level import runs (Caddy sorts abort before reverse_proxy).
	import cloudflare_only
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	# The chat (at most 1,000,000 bytes) and the contact form (at most 20,000)
	# answer a larger body themselves; nothing else takes a body.
	request_body {
		max_size 1MiB
	}
	reverse_proxy unix//run/isomux-site/site.sock {
		# The chat and contact form rate limits key on the first X-Forwarded-For address: replace whatever
		# the client or Cloudflare sent with the one address Caddy resolved.
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		# Stream chat replies as they arrive.
		flush_interval -1
		# A deploy recreates the site container (a few seconds); retry the socket
		# meanwhile instead of answering 502.
		lb_try_duration 15s
		lb_try_interval 250ms
		transport http {
			dial_timeout 5s
			response_header_timeout 70s
		}
	}
	# wg-caddy may write only /var/log/wg-caddy. The filter drops the request (client
	# address, headers), as Wall Game's log does.
	log {
		output file /var/log/wg-caddy/isomux-site-access.json {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}
