# /etc/isomux-site/auto-deploy.env (0600, root; the directory is 0700). Plain KEY=value
# lines, read by auto-deploy.sh and never run as shell. No secrets here: the chat's keys
# go in /etc/isomux-site/site.env (compose.yaml), and the Cloudflare purge token in
# /etc/isomux-site/purge-token (0600, one line).
ISOMUX_SITE_IMAGE=ghcr.io/nmamano/isomux-site
ISOMUX_SITE_GITHUB_REPO=nmamano/isomux
ISOMUX_SITE_IMAGE_WORKFLOW=site-image.yml
# The Cloudflare zone of isomux.com (an ID, not a secret). Without it, no purge runs.
#ISOMUX_SITE_CF_ZONE=<zone id>
# Optional: the tag to follow (default main). For a rehearsal: rehearsal-good or
# rehearsal-bad (.github/workflows/site-image-rehearsal.yml; main never moves).
#ISOMUX_SITE_TAG=main
