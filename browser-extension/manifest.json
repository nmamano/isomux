{
  "manifest_version": 3,
  "name": "Isomux Browser",
  "version": "0.10.3",
  "description": "Offer Chrome tabs and share pages with agents in an Isomux office.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "alarms",
    "webNavigation",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "connection.html",
  "action": {
    "default_popup": "connection.html",
    "default_title": "Isomux Browser",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
