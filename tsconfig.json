{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["server", "shared", "ui", "api", "control-plane"],
  // The hosted control plane's web app is its own package with its own
  // dependencies, tsconfig and build. It is type-checked by `bun run ci:web`
  // against Next's types, which exist only after that package is installed - so
  // it stays out of the repository-wide check rather than making a fresh clone
  // fail on a missing module.
  "exclude": ["control-plane/web"]
}
