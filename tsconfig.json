{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // TS 7 adds no ambient types by default. Without this, a program gets the
    // Bun globals only when one of its files imports "bun". typeRoots is
    // relative to this file: scripts/typecheck.ts runs each program from a
    // config in a temporary folder that extends this one.
    "types": ["bun"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "server",
    "shared",
    "browser-extension",
    "ui",
    "api",
    "control-plane",
    "deploy",
    "scripts",
    "site-host",
    "middleware.ts"
  ],
  // The hosted control plane's web app is its own package with its own
  // dependencies, tsconfig and build. Its `next build` in `bun run ci:web`
  // type-checks it against Next's types, which exist only after that package
  // is installed - so it stays out of the repository-wide check rather than
  // making a fresh clone fail on a missing module.
  "exclude": ["control-plane/web"]
}
