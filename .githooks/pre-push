#!/usr/bin/env bash
# Runs the exact CI gate (`bun run ci`: format:check, lint, typecheck, UI
# build, tests, web app) so a push that passes here passes on GitHub. One command on
# purpose - a hand-copied subset of the steps is how the two drifted apart.
# Bypass with `git push --no-verify` only after deciding the push is safe.
#
# scripts/ci-remote.sh runs it, here or on the machine git config
# isomux.ciRemote names, and tees the output to a file whose path it prints:
# the gate takes minutes, and its output otherwise lives only in whatever
# invoked the push - a pipe, a truncating wrapper, or a tool that reports the
# wrapper's exit code instead of this one. Losing it costs another full run to
# learn which step failed.
exec bash "$(dirname "${BASH_SOURCE[0]}")/../scripts/ci-remote.sh" --pre-push
