{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun install && bun run build:demo && bun run build:docs",
  "outputDirectory": "site",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs/self-hosted",
      "destination": "/docs/hosting",
      "permanent": true
    },
    {
      "source": "/_agent/docs/self-hosted/index.md",
      "destination": "/_agent/docs/hosting/index.md",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.isomux.com"
        }
      ],
      "destination": "https://isomux.com/:path*",
      "permanent": true
    },
    {
      "source": "/docs/vps-install",
      "destination": "/docs/hosting",
      "permanent": true
    },
    {
      "source": "/docs/deployments",
      "destination": "/docs/hosting",
      "permanent": true
    },
    {
      "source": "/_agent/docs/vps-install/index.md",
      "destination": "/_agent/docs/hosting/index.md",
      "permanent": true
    },
    {
      "source": "/_agent/docs/deployments/index.md",
      "destination": "/_agent/docs/hosting/index.md",
      "permanent": true
    },
    {
      "source": "/docs/use-cases-agents-for-normies",
      "destination": "/docs/use-cases-non-technical-colleagues",
      "permanent": true
    },
    {
      "source": "/_agent/docs/use-cases-agents-for-normies/index.md",
      "destination": "/_agent/docs/use-cases-non-technical-colleagues/index.md",
      "permanent": true
    },
    {
      "source": "/use-cases",
      "destination": "/docs/use-cases",
      "permanent": true
    },
    {
      "source": "/use-cases/parallel-agents",
      "destination": "/docs/use-cases-parallel-agents",
      "permanent": true
    },
    {
      "source": "/use-cases/phone",
      "destination": "/docs/use-cases-phone",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/hosted-terms",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/hosted-privacy",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/hosted#plans",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/((?!demo$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.github.com https://www.google-analytics.com https://*.google-analytics.com; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'self'; frame-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.github.com https://www.google-analytics.com https://*.google-analytics.com; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'self' https://nilmamano.com; frame-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\"; type=\"application/openapi+json\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </docs>; rel=\"service-doc\"; type=\"text/html\""
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    },
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api-catalog.json"
    },
    {
      "source": "/:path*",
      "destination": "/api/not-found?path=:path*"
    }
  ]
}
