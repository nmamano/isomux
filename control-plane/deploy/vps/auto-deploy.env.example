# /etc/isomux-hosted/auto-deploy.env, 0600: the deploy from main (auto-deploy.sh).
# The dedicated clone of the public repository; its origin is that repository.
ISOMUX_HOSTED_SRC=replace-with-the-clone-path
# owner/repo on GitHub, for the Build runs.
ISOMUX_HOSTED_GITHUB_REPO=replace-with-owner/replace-with-repo
