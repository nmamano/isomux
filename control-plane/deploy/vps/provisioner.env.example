# The provisioner's operator-written values. Copy to <env dir>/provisioner.env,
# mode 0600. Docker reads this file as data: one NAME=value per line, no quotes,
# no shell. deploy.sh supplies CONTROL_PLANE_DB, CONTROL_PLANE_DB_IDENTITY and
# CONTROL_PLANE_MINT_TOKEN from <env dir>/generated/; compose.yaml supplies
# ISOMUX_PRODUCTION_RUNTIME.
CONTROL_PLANE_STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=replace-with-the-stripe-test-key
STRIPE_WEBHOOK_SECRET=replace-with-the-test-webhook-signing-secret
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
CONTABO_CLIENT_ID=replace-with-the-contabo-client-id
CONTABO_CLIENT_SECRET=replace-with-the-contabo-client-secret
CONTABO_API_USER=replace-with-the-contabo-api-user
CONTABO_API_PASSWORD=replace-with-the-contabo-api-password
ISOMUX_CF_ZONE_ID=replace-with-the-cloudflare-zone-id
ISOMUX_CF_TOKEN=replace-with-the-cloudflare-token
ISOMUX_ACME_EMAIL=certificates@example.com
ISOMUX_CERT_TARGET=production
ISOMUX_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
ISOMUX_CF_API=https://api.cloudflare.com/client/v4
ISOMUX_CERTIFICATE_LIVE=1
ISOMUX_CERTIFICATE_ENDPOINT=https://provisioner.example.com/internal/certificates/renew
