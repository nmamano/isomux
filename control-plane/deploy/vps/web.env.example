# The storefront's operator-written values. Copy to <env dir>/web.env, mode 0600.
# Docker reads this file as data: one NAME=value per line, no quotes, no shell.
# deploy.sh supplies CONTROL_PLANE_DB, CONTROL_PLANE_DB_IDENTITY and
# CONTROL_PLANE_MINT_TOKEN from <env dir>/generated/; compose.yaml supplies
# CONTROL_PLANE_MINT_URL and ISOMUX_PRODUCTION_RUNTIME.
AUTH_URL=https://storefront.example.com
AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=replace-with-the-google-client-id
AUTH_GOOGLE_SECRET=replace-with-the-google-client-secret
CONTROL_PLANE_STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=replace-with-the-stripe-test-key
STRIPE_LIVE_SECRET_KEY=
CONTROL_PLANE_ENTRY_PRICE_ID=replace-with-the-entry-price-id
CONTROL_PLANE_POWERUSER_PRICE_ID=replace-with-the-poweruser-price-id
