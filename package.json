{
  "name": "isomux",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "bun run build:ui && bun run server/isomux-office.ts",
    "build:ui": "bash scripts/build.sh",
    "build:demo": "bun run scripts/build-demo.ts",
    "build:docs": "bun run scripts/build-docs.ts",
    "server": "bun run server/isomux-office.ts",
    "gen:codex-schemas": "bun run scripts/gen-codex-schemas.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "lint:web": "eslint --config control-plane/web/eslint.config.mjs control-plane/web",
    "test": "bun test",
    "test:install-fetch": "ISOMUX_TEST_INSTALL_FETCH=1 bun test deploy/install-docs.test.ts",
    "test:live": "ISOMUX_TEST_LIVE=1 bun test",
    "test:opencode": "ISOMUX_TEST_OPENCODE=1 bun test server/test-support/agent-manager.opencode.live.test.ts",
    "test:systemd": "ISOMUX_TEST_SYSTEMD=1 bun test server/app-supervisor.live.test.ts",
    "ci:web": "bun install --cwd control-plane/web --frozen-lockfile && bun run --cwd control-plane/web build && bun run --cwd control-plane/web typecheck && bun run lint:web",
    "ci": "bun run scripts/ci.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.219",
    "@anthropic-ai/sdk": "^0.100.1",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@openai/codex": "0.144.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "node-pty": "^1.1.0",
    "opencode-v1": "npm:opencode-ai@1.18.23",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
