{
  "name": "isomux",
  "license": "BUSL-1.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "bun run build:ui && bun run server/isomux-office.ts",
    "build:ui": "bash scripts/build.sh",
    "build:extension": "bun run scripts/build-browser-extension.ts",
    "build:demo": "bun run scripts/build-demo.ts",
    "build:docs": "bun run scripts/build-docs.ts",
    "server": "bun run server/isomux-office.ts",
    "gen:codex-schemas": "bun run scripts/gen-codex-schemas.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run scripts/lint.ts",
    "lint:fix": "bun run scripts/lint.ts --fix",
    "lint:web": "eslint --config control-plane/web/eslint.config.mjs control-plane/web",
    "test": "bun test",
    "test:install-fetch": "ISOMUX_TEST_INSTALL_FETCH=1 bun test deploy/install-docs.test.ts",
    "test:live": "ISOMUX_TEST_LIVE=1 bun test",
    "test:opencode": "ISOMUX_TEST_OPENCODE=1 bun test server/test-support/agent-manager.opencode.live.test.ts server/test-support/agent-manager.opencode.errors.live.test.ts server/backends/opencode/adapter.test.ts server/backends/opencode/authority-broker.opencode.test.ts server/test-support/agent-manager.di.test.ts server/backends/opencode/supervisor.test.ts",
    "test:opencode:ci": "ISOMUX_TEST_OPENCODE=1 bun test server/test-support/agent-manager.opencode.live.test.ts server/test-support/agent-manager.opencode.errors.live.test.ts server/backends/opencode/adapter.test.ts server/backends/opencode/authority-broker.opencode.test.ts",
    "test:systemd": "ISOMUX_TEST_SYSTEMD=1 bun test server/app-supervisor.live.test.ts",
    "ci:web": "bun install --cwd control-plane/web --frozen-lockfile && bun run --cwd control-plane/web build && bun run --cwd control-plane/web typecheck && bun run lint:web",
    "ci": "bun run scripts/ci.ts",
    "ci:remote": "bash scripts/ci-remote.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@openai/codex": "0.162.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff2html": "^3.4.56",
    "entities": "^8.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.1.0",
    "opencode-v1": "npm:opencode-ai@1.18.35",
    "pg": "^8.23.1",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
