{
  "name": "isomux",
  "type": "module",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "bun run build:ui && bun run server/index.ts",
    "build:ui": "bash scripts/build.sh",
    "build:docs": "bun run scripts/build-docs.ts",
    "server": "bun run server/index.ts",
    "gen:codex-schemas": "bun run scripts/gen-codex-schemas.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "test": "bun test",
    "test:live": "ISOMUX_TEST_LIVE=1 bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.170",
    "@anthropic-ai/sdk": "^0.96.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.1",
    "@openai/codex": "0.144.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
